{
  "name": "@entitykit/example-bookshop",
  "version": "0.1.0",
  "private": true,
  "description": "A tenant-scoped bookstore checkout and durable delivery qualification example.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "verify": "npm run lint && npm run build && npm run qualify:sqlite",
    "qualify:sqlite": "node --unhandled-rejections=strict dist/qualify.js sqlite",
    "qualify:postgres": "node --unhandled-rejections=strict dist/qualify.js postgres",
    "qualify:mysql": "node --unhandled-rejections=strict dist/qualify.js mysql"
  },
  "dependencies": {
    "@entitykit/core": "0.1.0-alpha.2",
    "@entitykit/sqlite": "0.1.0-alpha.2",
    "@entitykit/postgres": "0.1.0-alpha.2",
    "@entitykit/mysql": "0.1.0-alpha.2"
  },
  "engines": { "node": ">=22.13" }
}
