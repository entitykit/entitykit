{
  "name": "@entitykit/cli",
  "version": "0.1.0-alpha.1",
  "description": "The EntityKit command-line interface for scaffolding, migrations, and project inspection.",
  "keywords": [
    "orm",
    "typescript",
    "entitykit",
    "cli",
    "migrations"
  ],
  "author": "zsumz <shawn@zsumz.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://git.shawn.mn/entitykit-poc/entitykit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://git.shawn.mn/entitykit-poc/entitykit",
  "bugs": {
    "url": "https://git.shawn.mn/entitykit-poc/entitykit/issues"
  },
  "type": "commonjs",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "require": "./dist/api.js",
      "default": "./dist/api.js"
    }
  },
  "bin": {
    "entitykit": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "dependencies": {
    "@entitykit/core": "0.1.0-alpha.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "sideEffects": false
}
