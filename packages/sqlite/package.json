{
  "name": "@entitykit/sqlite",
  "version": "0.1.0-alpha.2",
  "description": "The SQLite provider for EntityKit, backed by the Node.js built-in node:sqlite driver.",
  "keywords": [
    "orm",
    "typescript",
    "entitykit",
    "sqlite",
    "provider"
  ],
  "author": "zsumz <shawn@zsumz.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entitykit/entitykit.git",
    "directory": "packages/sqlite"
  },
  "homepage": "https://github.com/entitykit/entitykit",
  "bugs": {
    "url": "https://github.com/entitykit/entitykit/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/guard-alpha-publish.js"
  },
  "peerDependencies": {
    "@entitykit/core": "0.1.0-alpha.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "sideEffects": false
}
